# GenRichi Portal — environment configuration template.
#
# Copy this file to portal/.env and fill in real values there.
# portal/.env is gitignored and must never be committed.
# Never put a real value in this .env.example file.

# Required — the portal will not start without these two:
SECRET_KEY=<SET_IN_ENVIRONMENT>
PORTAL_PASS=<SET_IN_ENVIRONMENT>

# Optional — non-secret, defaults shown:
PORTAL_USER=admin

# Email notifications — SMTP_ENABLED defaults to true. Set it to false
# here if you don't want to configure email. SMTP_PASS is only required
# (and only checked at startup) when SMTP_ENABLED is true.
SMTP_ENABLED=true
SMTP_PASS=<SET_IN_ENVIRONMENT>
